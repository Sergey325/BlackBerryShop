model NovaPoshtaCity {
  id        Int      @id @default(autoincrement())
  ref       String   @unique
  name      String
  area      String
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Order {
  id          Int         @id @default(autoincrement())
  invoiceId   String?     @unique // id от Monobank
  status      OrderStatus @default(PENDING)
  totalAmount Float

  // Данные заказчика
  firstName String
  lastName  String
  phone     String
  email     String?
  comment   String?

  // Доставка
  city            String
  area            String
  cityRef         String
  warehouse       String
  warehouseNumber Int
  warehouseRef    String

  // Оплата
  paymentMethod PaymentMethod

  // ТТН
  ttnNumber String?
  ttnRef    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  name      String
  price     Float
  quantity  Int
  color     String
  colorName String?
  size      String
  imageUrl  String
}

model TelegramUser {
  id     Int     @id @default(autoincrement())
  chatId String  @unique
  name   String?
  role   String  @default("ADMIN")
}

enum OrderStatus {
  PENDING // ожидает оплаты
  PAID // оплачено
  PROCESSING // в обработке
  SHIPPED // отправлено
  DELIVERED // доставлено
  CANCELLED // отменено
  REFUNDED // возврат
}

enum PaymentMethod {
  MONOBANK
  CASH_ON_DELIVERY
}
