// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String
  description  String
  price        Float
  isBestseller Boolean @default(false)
  discount     Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colors     ProductColor[]
  categoryId Int?
  category   Category?      @relation(fields: [categoryId], references: [id])

  materialId Int?
  material   Material? @relation(fields: [materialId], references: [id])
}

model ProductColor {
  id        Int     @id @default(autoincrement())
  color     String
  colorName String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  images ProductImage[]
  sizes  ProductSize[]
}

model ProductImage {
  id             Int          @id @default(autoincrement())
  url            String
  order          Int          @default(0)
  productColorId Int
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
}

model ProductSize {
  id             Int          @id @default(autoincrement())
  size           String
  available      Boolean      @default(true)
  productColorId Int
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
}

model Material {
  id Int @id @default(autoincrement())

  name String @unique

  products Product[]
}

model Category {
  id                  Int      @id @default(autoincrement())
  name                String
  slug                String   @unique
  productsDescription String
  description         String
  coverImage          String // заглавное фото
  season              Season
  isOnMainPage        Boolean? @default(false)

  products Product[]

  // Какие категории "часто покупают вместе" с этой категорией
  relatedTo   CategoryRelation[] @relation("CategoryRelation_From")
  relatedFrom CategoryRelation[] @relation("CategoryRelation_To")

  specifications CategorySpecification[]
}

enum Season {
  SUMMER
  WINTER
  ALL_SEASON
}

model CategoryRelation {
  id Int @id @default(autoincrement())

  fromCategoryId Int
  fromCategory   Category @relation("CategoryRelation_From", fields: [fromCategoryId], references: [id], onDelete: Cascade)

  toCategoryId Int
  toCategory   Category @relation("CategoryRelation_To", fields: [toCategoryId], references: [id], onDelete: Cascade)

  @@unique([fromCategoryId, toCategoryId])
}

model CategorySpecification {
  id Int @id @default(autoincrement())

  name  String
  value String

  order Int @default(0)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
}

