generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  id                Int                @id @default(autoincrement())
  name              String
  price             Float
  discount          Float              @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  slug              String
  description       String?
  hasLining         Boolean            @default(false)
  categoryId        Int?
  materialId        Int?
  category          Category?          @relation(fields: [categoryId], references: [id])
  material          Material?          @relation(fields: [materialId], references: [id])
  colors            ProductColor[]
  relatedTo         ProductRelation[]  @relation("ProductRelation_From")
  relatedFrom       ProductRelation[]  @relation("ProductRelation_To")
  promoCodeProducts PromoCodeProduct[]
}

model ProductColor {
  id           Int            @id @default(autoincrement())
  color        String
  productId    Int
  colorName    String
  isBestSeller Boolean        @default(false)
  colorCode    String?
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images       ProductImage[]
  sizes        ProductSize[]
}

model ProductImage {
  id             Int          @id @default(autoincrement())
  url            String
  order          Int          @default(0)
  productColorId Int
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
}

model ProductSize {
  id             Int          @id @default(autoincrement())
  size           String
  available      Boolean      @default(true)
  productColorId Int
  quantity       Int?
  orderItems     OrderItem[]
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
}

model Material {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model ProductRelation {
  id            Int     @id @default(autoincrement())
  fromProductId Int
  toProductId   Int
  order         Int     @default(0)
  reason        String?
  fromProduct   Product @relation("ProductRelation_From", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct     Product @relation("ProductRelation_To", fields: [toProductId], references: [id], onDelete: Cascade)

  @@unique([fromProductId, toProductId])
}

model Banner {
  id       Int      @id @default(autoincrement())
  image    String
  badge    String?
  title    String
  features String[]
  ctaHref  String?
  ctaLabel String?
  order    Int      @default(0)
}

model Category {
  id                  Int                     @id @default(autoincrement())
  name                String
  slug                String                  @unique
  description         String
  coverImage          String
  season              Season
  productsDescription String
  isOnMainPage        Boolean?                @default(false)
  isDecoration        Boolean?                @default(false)
  sizeGuideImage      String?
  defaultSizes        String[]                @default([])
  specifications      CategorySpecification[]
  products            Product[]
  promoCodeCategories PromoCodeCategory[]
}

model CategorySpecification {
  id         Int      @id @default(autoincrement())
  name       String
  value      String
  order      Int      @default(0)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
}

model NovaPoshtaCity {
  id        Int      @id @default(autoincrement())
  ref       String   @unique
  name      String
  area      String
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Order {
  id            Int           @id @default(autoincrement())
  invoiceId     String?       @unique
  status        OrderStatus   @default(PENDING)
  totalAmount   Float
  firstName     String
  lastName      String
  phone         String
  email         String?
  comment       String?
  city          String
  cityRef       String
  warehouse     String
  warehouseRef  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  paymentMethod PaymentMethod
  area          String

  ttnNumber          String?
  ttnRef             String?
  ttnStatus          String? // текстовый статус от НП, напр. "Прямує до м. Київ"
  ttnStatusCode      String? // код статуса НП, напр. "9", "41", "44"
  ttnStatusUpdatedAt DateTime?

  warehouseNumber        Int
  clientIp               String?
  fbc                    String?
  fbp                    String?
  userAgent              String?
  paidAt                 DateTime?
  discountAmount         Float?
  discountPercentApplied Float?
  promoCodeId            Int?
  promoCodeSnapshot      String?
  promoCode              PromoCode?  @relation(fields: [promoCodeId], references: [id])
  items                  OrderItem[]
}

model OrderItem {
  id            Int          @id @default(autoincrement())
  orderId       Int
  productId     Int
  name          String
  price         Float
  quantity      Int
  color         String
  size          String?
  imageUrl      String
  colorName     String?
  productSizeId Int?
  colorCode     String?
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id])

  @@index([productSizeId])
}

model TelegramUser {
  id     Int     @id @default(autoincrement())
  chatId String  @unique
  name   String?
  role   String  @default("ADMIN")
}

model PromoCode {
  id              Int                 @id @default(autoincrement())
  code            String              @unique
  discountPercent Float
  scopeType       PromoScopeType      @default(ALL)
  startsAt        DateTime?
  expiresAt       DateTime?
  maxUses         Int?
  usedCount       Int                 @default(0)
  isActive        Boolean             @default(true)
  isDeleted       Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  orders          Order[]
  categories      PromoCodeCategory[]
  products        PromoCodeProduct[]
}

model PromoCodeCategory {
  id          Int       @id @default(autoincrement())
  promoCodeId Int
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, categoryId])
}

model PromoCodeProduct {
  id          Int       @id @default(autoincrement())
  promoCodeId Int
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, productId])
}

model MonthlyExpense {
  id          Int       @id @default(autoincrement())
  year        Int
  month       Int
  amount      Float
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenseDate DateTime? @db.Date

  @@index([year, month])
}

enum Season {
  SUMMER
  WINTER
  ALL_SEASON
}

enum PromoScopeType {
  ALL
  CATEGORY
  PRODUCT
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MONOBANK
  CASH_ON_DELIVERY
}
